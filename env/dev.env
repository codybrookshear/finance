# Local development (make dev). Safe to commit: 1Password references, not
# secrets. scripts/secrets-write.sh turns each KEY into a file named key.
POSTGRES_OWNER_PASSWORD=op://Finance App/finance-dev-db/owner_password
FINANCE_SYNC_DB_PASSWORD=op://Finance App/finance-dev-db/sync_password
FINANCE_WEB_DB_PASSWORD=op://Finance App/finance-dev-db/web_password
# Access URL claimed from SimpleFIN's public demo token (fake data).
SIMPLEFIN_ACCESS_URL=op://Finance App/simplefin-demo/access_url
