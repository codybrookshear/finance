# Four syncs a day, comfortably under SimpleFIN Bridge's ~24 requests/day.
# Local times, chosen to finish well before unattended-upgrades may reboot
# the droplet at 04:30 UTC (20:30 or 21:30 local). The day's last run sets
# that day's balance snapshot.

[Unit]
Description=Finance: SimpleFIN sync four times a day

[Timer]
OnCalendar=*-*-* 01,07,13,19:40:00 America/Los_Angeles
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
