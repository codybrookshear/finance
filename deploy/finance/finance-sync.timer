# Every 3 hours (1:40, 4:40, ... local), so a newly connected bank shows up
# within about 3 hours. SimpleFIN Bridge asks for at most ~24 requests/day:
# each run makes 1 request plus at most 2 while history is being backfilled,
# so 8 runs stay within it (and use 8/day once history is complete). None
# runs near the 04:30 UTC unattended-upgrades reboot (20:30 or 21:30 local).
# The web footer's "next sync" assumes this interval (syncEvery in web.go).

[Unit]
Description=Finance: SimpleFIN sync every 3 hours

[Timer]
OnCalendar=*-*-* 01/3:40:00 America/Los_Angeles
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
