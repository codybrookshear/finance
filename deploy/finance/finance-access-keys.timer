# Cloudflare rotates Access signing keys every 6 weeks and keeps the old one
# valid for a week, so hourly is plenty; the web app also re-reads the file
# when a token names a key it doesn't have yet.

[Unit]
Description=Finance: refresh Cloudflare Access signing keys hourly

[Timer]
OnBootSec=1min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
